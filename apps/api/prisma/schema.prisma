generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  SALES
  WAREHOUSE
}

enum BookingStatus {
  DRAFT
  QUOTED
  CONFIRMED
  DISPATCHED
  RETURNED
  COMPLETED
  CANCELLED
  ACTIVE
}

enum BookingLineType {
  PACKAGE
  INVENTORY_ITEM
}

enum MovementType {
  ADJUSTMENT
  DAMAGE
  MISSING
  MAINTENANCE
  MAINTENANCE_RESTORE
  CHECK_OUT
  CHECK_IN
  DAMAGE_WRITE_OFF
}

enum DamageStatus {
  REPORTED
  ASSESSED
  REPAIRED
  WRITTEN_OFF
}

enum PackageVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

enum IdempotencyOperation {
  CONFIRM
  CANCEL
  RESCHEDULE
  DISPATCH
  RETURN
  COMPLETE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

// -----------------------------------------------------------------------------
// Tenant Root
// -----------------------------------------------------------------------------

model Business {
  id        String   @id @default(uuid())
  name      String
  slug                       String   @unique
  plan                       String   @default("FREE")
  defaultBufferBeforeMinutes Int      @default(0)
  defaultBufferAfterMinutes  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  users                User[]
  customers            Customer[]
  categories           Category[]
  inventoryItems       InventoryItem[]
  packages             Package[]
  packageVersions      PackageVersion[]
  packageComponents    PackageComponent[]
  bookings             Booking[]
  bookingItemDemands   BookingItemDemand[]
  inventoryReservations InventoryReservation[]
  inventoryMovements   InventoryMovement[]
  damageReports        DamageReport[]
  auditEvents          AuditEvent[]
  idempotencyRecords   IdempotencyRecord[]

  @@map("businesses")
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  email        String
  passwordHash String
  role         UserRole @default(SALES)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  bookings           Booking[]

  @@unique([businessId, email])
  @@map("users")
}

model Customer {
  id         String    @id @default(uuid())
  businessId String
  name       String
  email      String?
  phone      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("customers")
}

// -----------------------------------------------------------------------------
// Inventory Domain
// -----------------------------------------------------------------------------

model Category {
  id         String   @id @default(uuid())
  businessId String
  name                String
  parentId            String?
  bufferBeforeMinutes Int?
  bufferAfterMinutes  Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryToCategory")
  inventoryItems InventoryItem[]

  @@map("categories")
}

model InventoryItem {
  id             String    @id @default(uuid())
  businessId     String
  categoryId     String?
  name           String
  sku            String?
  totalQty       Int       @default(0)
  damagedQty     Int       @default(0)
  missingQty     Int       @default(0)
  maintenanceQty      Int       @default(0)
  bufferBeforeMinutes Int?
  bufferAfterMinutes  Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  packageComponents     PackageComponent[]
  bookingItemDemands    BookingItemDemand[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  damageReports         DamageReport[]
  bookingLines          BookingLine[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, categoryId])
  @@index([businessId, id])
  @@map("inventory_items")
}

// -----------------------------------------------------------------------------
// Packages Domain
// -----------------------------------------------------------------------------

model Package {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageVersions PackageVersion[]

  @@map("packages")
}

model PackageVersion {
  id            String               @id @default(uuid())
  packageId     String
  businessId    String
  versionNumber Int
  status        PackageVersionStatus @default(DRAFT)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  package           Package            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageComponents PackageComponent[]
  bookingLines      BookingLine[]

  @@unique([packageId, versionNumber])
  @@map("package_versions")
}

model PackageComponent {
  id               String   @id @default(uuid())
  packageVersionId String
  businessId       String
  inventoryItemId  String
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageVersion  PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([packageVersionId, inventoryItemId])
  @@map("package_components")
}

// -----------------------------------------------------------------------------
// Bookings Domain
// -----------------------------------------------------------------------------

model Booking {
  id              String        @id @default(uuid())
  businessId      String
  customerId      String
  eventName       String
  eventStart      DateTime
  eventEnd        DateTime
  location        String?
  notes           String?
  status          BookingStatus @default(DRAFT)
  period          Unsupported("tstzrange")
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser         User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  bookingLines          BookingLine[]
  bookingItemDemands    BookingItemDemand[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  damageReports         DamageReport[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId])
  @@map("bookings")
}

model BookingLine {
  id               String          @id @default(uuid())
  bookingId        String
  type             BookingLineType
  packageVersionId String?
  inventoryItemId  String?
  quantity         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  packageVersion PackageVersion? @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  inventoryItem  InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@map("booking_lines")
}

model BookingItemDemand {
  id                String   @id @default(uuid())
  bookingId         String
  businessId        String
  inventoryItemId   String
  quantityDemanded  Int
  quantity          Int?
  quantityFulfilled Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryReservation InventoryReservation?

  @@map("booking_item_demands")
}

model InventoryReservation {
  id                  String   @id @default(uuid())
  businessId          String
  inventoryItemId     String
  bookingId           String
  bookingItemDemandId String?  @unique
  quantity            Int
  status              ReservationStatus @default(ACTIVE)
  period              Unsupported("tstzrange")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItemDemand BookingItemDemand? @relation(fields: [bookingItemDemandId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([businessId, inventoryItemId])
  @@map("inventory_reservations")
}

// -----------------------------------------------------------------------------
// Operations Domain
// -----------------------------------------------------------------------------

model InventoryMovement {
  id              String       @id @default(uuid())
  businessId      String
  inventoryItemId String
  bookingId       String?
  movementType    MovementType
  quantityDelta   Int
  notes           String?
  createdByUserId String?
  createdAt       DateTime     @default(now())

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdByUser   User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, inventoryItemId])
  @@map("inventory_movements")
}

model DamageReport {
  id              String       @id @default(uuid())
  businessId      String
  inventoryItemId String
  bookingId       String?
  quantityDamaged Int
  status          DamageStatus @default(REPORTED)
  description     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("damage_reports")
}

// -----------------------------------------------------------------------------
// System Domain
// -----------------------------------------------------------------------------

model AuditEvent {
  id         String      @id @default(uuid())
  businessId String
  userId     String?
  action     AuditAction
  tableName  String
  recordId   String
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("audit_events")
}

model IdempotencyRecord {
  id           String               @id @default(uuid())
  businessId   String
  key          String
  operation    IdempotencyOperation
  bookingId    String
  requestHash  String
  status       IdempotencyStatus
  statusCode   Int
  responseBody Json
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([bookingId])
  @@map("idempotency_records")
}

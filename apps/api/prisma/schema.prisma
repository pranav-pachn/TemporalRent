generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  SALES
  WAREHOUSE
}

enum BookingStatus {
  DRAFT
  QUOTED
  CONFIRMED
  DISPATCHED
  RETURNED
  COMPLETED
  CANCELLED
  ACTIVE
}

enum BookingLineType {
  PACKAGE
  INVENTORY_ITEM
}

enum MovementType {
  ADJUSTMENT
  DAMAGE
  MISSING
  MAINTENANCE
  MAINTENANCE_RESTORE
  CHECK_OUT
  CHECK_IN
  DAMAGE_WRITE_OFF
  DISPATCH
  RETURN_GOOD
}

enum DamageStatus {
  REPORTED
  ASSESSED
  REPAIRED
  WRITTEN_OFF
}

enum PackageVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum DispatchStatus {
  READY
  PICKING
  DISPATCHED
  CANCELLED
}

enum ReturnStatus {
  INSPECTION
  COMPLETED
}


enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CONFIRM
  CANCEL
  RESCHEDULE
  START_PICKING
  DISPATCH
  RETURN
  DAMAGE
  OVERRIDE
}

enum AuditEntityType {
  BUSINESS
  USER
  CUSTOMER
  INVENTORY_ITEM
  PACKAGE
  PACKAGE_VERSION
  BOOKING
  BOOKING_LINE
  BOOKING_ITEM_DEMAND
  INVENTORY_RESERVATION
  DISPATCH
  DISPATCH_LINE
  RETURN
  RETURN_LINE
  DAMAGE_REPORT
}

enum IdempotencyOperation {
  CONFIRM
  CANCEL
  RESCHEDULE
  DISPATCH
  RETURN
  COMPLETE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

// -----------------------------------------------------------------------------
// Tenant Root
// -----------------------------------------------------------------------------

model Business {
  id        String   @id @default(uuid())
  name      String
  slug                       String   @unique
  plan                       String   @default("FREE")
  timezone                   String   @default("UTC")
  defaultBufferBeforeMinutes Int      @default(0)
  defaultBufferAfterMinutes  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  users                User[]
  customers            Customer[]
  categories           Category[]
  inventoryItems       InventoryItem[]
  packages             Package[]
  packageVersions      PackageVersion[]
  packageComponents    PackageComponent[]
  bookings             Booking[]
  bookingItemDemands   BookingItemDemand[]
  inventoryReservations InventoryReservation[]
  inventoryMovements   InventoryMovement[]
  damageReports        DamageReport[]
  auditEvents          AuditEvent[]
  idempotencyRecords   IdempotencyRecord[]
  dispatches           Dispatch[]
  returns              Return[]

  @@map("businesses")
}

model User {
  id           String    @id @default(uuid())
  businessId   String?
  email        String
  name         String?
  avatarUrl    String?
  passwordHash String?
  role         UserRole  @default(SALES)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  oauthAccounts OAuthAccount[]
  sessions      Session[]

  inventoryMovements InventoryMovement[]
  bookings           Booking[]
  auditEvents        AuditEvent[]

  @@unique([businessId, email])
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  businessId   String?
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Customer {
  id         String    @id @default(uuid())
  businessId String
  name       String
  email      String?
  phone      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("customers")
}

// -----------------------------------------------------------------------------
// Inventory Domain
// -----------------------------------------------------------------------------

model Category {
  id         String   @id @default(uuid())
  businessId String
  name                String
  parentId            String?
  bufferBeforeMinutes Int?
  bufferAfterMinutes  Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryToCategory")
  inventoryItems InventoryItem[]

  @@map("categories")
}

model InventoryItem {
  id             String    @id @default(uuid())
  businessId     String
  categoryId     String?
  name           String
  sku            String?
  totalQty       Int       @default(0)
  damagedQty     Int       @default(0)
  missingQty     Int       @default(0)
  maintenanceQty      Int       @default(0)
  bufferBeforeMinutes Int?
  bufferAfterMinutes  Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  packageComponents     PackageComponent[]
  bookingItemDemands    BookingItemDemand[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  damageReports         DamageReport[]
  bookingLines          BookingLine[]
  dispatchLines         DispatchLine[]
  returnLines           ReturnLine[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, categoryId])
  @@index([businessId, id])
  @@map("inventory_items")
}

// -----------------------------------------------------------------------------
// Packages Domain
// -----------------------------------------------------------------------------

model Package {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageVersions PackageVersion[]

  @@map("packages")
}

model PackageVersion {
  id            String               @id @default(uuid())
  packageId     String
  businessId    String
  versionNumber Int
  status        PackageVersionStatus @default(DRAFT)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  package           Package            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageComponents PackageComponent[]
  bookingLines      BookingLine[]

  @@unique([packageId, versionNumber])
  @@map("package_versions")
}

model PackageComponent {
  id               String   @id @default(uuid())
  packageVersionId String
  businessId       String
  inventoryItemId  String
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageVersion  PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([packageVersionId, inventoryItemId])
  @@map("package_components")
}

// -----------------------------------------------------------------------------
// Bookings Domain
// -----------------------------------------------------------------------------

model Booking {
  id              String        @id @default(uuid())
  businessId      String
  customerId      String
  eventName       String
  eventStart      DateTime
  eventEnd        DateTime
  location        String?
  notes           String?
  status          BookingStatus @default(DRAFT)
  period          Unsupported("tstzrange")
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser         User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  bookingLines          BookingLine[]
  bookingItemDemands    BookingItemDemand[]
  inventoryReservations InventoryReservation[]
  inventoryMovements    InventoryMovement[]
  damageReports         DamageReport[]
  dispatch              Dispatch?
  return                Return?

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId])
  @@map("bookings")
}

model BookingLine {
  id               String          @id @default(uuid())
  bookingId        String
  type             BookingLineType
  packageVersionId String?
  inventoryItemId  String?
  quantity         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  packageVersion PackageVersion? @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)
  inventoryItem  InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@map("booking_lines")
}

model BookingItemDemand {
  id                String   @id @default(uuid())
  bookingId         String
  businessId        String
  inventoryItemId   String
  quantityDemanded  Int
  quantity          Int?
  quantityFulfilled Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryReservation InventoryReservation?
  dispatchLines DispatchLine[]

  @@map("booking_item_demands")
}

model InventoryReservation {
  id                  String   @id @default(uuid())
  businessId          String
  inventoryItemId     String
  bookingId           String
  bookingItemDemandId String?  @unique
  quantity            Int
  status              ReservationStatus @default(ACTIVE)
  period              Unsupported("tstzrange")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItemDemand BookingItemDemand? @relation(fields: [bookingItemDemandId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([businessId, inventoryItemId])
  @@map("inventory_reservations")
}

// -----------------------------------------------------------------------------
// Operations Domain
// -----------------------------------------------------------------------------

model InventoryMovement {
  id              String       @id @default(uuid())
  businessId      String
  inventoryItemId String
  bookingId       String?
  movementType    MovementType
  quantityDelta   Int
  notes           String?
  createdByUserId String?
  createdAt       DateTime     @default(now())

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdByUser   User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, inventoryItemId])
  @@map("inventory_movements")
}

model DamageReport {
  id              String       @id @default(uuid())
  businessId      String
  inventoryItemId String
  bookingId       String?
  returnLineId    String?
  quantityDamaged Int
  quantity        Int          @default(1)
  severity        String?
  status          DamageStatus @default(REPORTED)
  description     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  returnLine    ReturnLine?   @relation(fields: [returnLineId], references: [id], onDelete: SetNull)

  @@map("damage_reports")
}

// -----------------------------------------------------------------------------
// Warehouse Dispatch & Returns Domain
// -----------------------------------------------------------------------------

model Dispatch {
  id           String         @id @default(uuid())
  businessId   String
  bookingId    String         @unique
  status       DispatchStatus @default(READY)
  dispatchedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lines    DispatchLine[]

  @@map("dispatches")
}

model DispatchLine {
  id                  String   @id @default(uuid())
  dispatchId          String
  inventoryItemId     String
  bookingItemDemandId String
  expectedQty         Int
  dispatchedQty       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dispatch          Dispatch          @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  bookingItemDemand BookingItemDemand @relation(fields: [bookingItemDemandId], references: [id], onDelete: Cascade)
  returnLines       ReturnLine[]

  @@unique([dispatchId, bookingItemDemandId])
  @@map("dispatch_lines")
}

model Return {
  id                String       @id @default(uuid())
  businessId        String
  bookingId         String       @unique
  status            ReturnStatus @default(INSPECTION)
  inspectedAt       DateTime?
  inspectedByUserId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lines         ReturnLine[]

  @@map("returns")
}

model ReturnLine {
  id              String   @id @default(uuid())
  returnId        String
  dispatchLineId  String
  inventoryItemId String
  expectedQty     Int
  returnedGoodQty Int      @default(0)
  damagedQty      Int      @default(0)
  missingQty      Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  return        Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  dispatchLine  DispatchLine   @relation(fields: [dispatchLineId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  damageReports DamageReport[]

  @@map("return_lines")
}

// -----------------------------------------------------------------------------
// System Domain
// -----------------------------------------------------------------------------

model AuditEvent {
  id         String          @id @default(uuid())
  businessId String
  bookingId  String?
  userId     String?
  action     AuditAction
  entityType AuditEntityType
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  metadata   Json?
  createdAt  DateTime        @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, bookingId, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([businessId, action, createdAt])
  @@map("audit_events")
}

model IdempotencyRecord {
  id           String               @id @default(uuid())
  businessId   String
  key          String
  operation    IdempotencyOperation
  bookingId    String
  requestHash  String
  status       IdempotencyStatus
  statusCode   Int
  responseBody Json
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([bookingId])
  @@map("idempotency_records")
}

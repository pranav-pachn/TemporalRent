    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "helmet": "^7.1.0",
    "jose": "^6.2.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
